# Copy this file to .env and fill in the key. Never commit .env.

# Model API key from the Claude Console. Used by the agent (added in a later step).
ANTHROPIC_API_KEY=

# Local Postgres started by `npm run db:up` (see docker-compose.yml).
DATABASE_URL=postgres://ttp:ttp@localhost:5433/ttp

# Port for the backend API.
API_PORT=3001
